{{- $shell := (get . "shell") | default dict -}}
{{- if or (get $shell "bash" | default false) (get $shell "zsh" | default false) -}}
# Shared shell customizations sourced from enterprise-managed shell rc files.
if [ -x "$HOME/.local/bin/kak-tmux-session" ]; then
    export EDITOR="$HOME/.local/bin/kak-tmux-session"
    export GIT_EDITOR="$HOME/.local/bin/kak-tmux-session"
    k() {
        "$HOME/.local/bin/kak-tmux-session" "$@"
    }
fi

if [ -x "$HOME/.local/bin/kak-picker-files" ]; then
    kff() {
        "$HOME/.local/bin/kak-picker-files" "$@"
    }
fi

if [ -x "$HOME/.local/bin/kak-picker-grep" ]; then
    kfg() {
        "$HOME/.local/bin/kak-picker-grep" "$@"
    }
fi

if [ -x "$HOME/.local/bin/kak-picker-directories" ]; then
    kfd() {
        "$HOME/.local/bin/kak-picker-directories" "$@"
    }
fi

if [ -x "$HOME/.local/bin/kak-note-todo" ]; then
    knt() {
        "$HOME/.local/bin/kak-note-todo" "$@"
    }
fi

if [ -x "$HOME/.local/bin/kak-note-list" ]; then
    knf() {
        "$HOME/.local/bin/kak-note-list" "$@"
    }
fi

if [ -x "$HOME/.local/bin/kak-note-grep" ]; then
    kng() {
        "$HOME/.local/bin/kak-note-grep" "$@"
    }
fi
{{- end -}}
