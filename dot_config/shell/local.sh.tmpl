wt_repo_name() {
    d=$(git rev-parse --path-format=absolute --git-common-dir) || return 1
    if [ "$(git rev-parse --is-bare-repository)" = "true" ]; then
        basename "$d" .git
    else
        basename "$(dirname "$d")"
    fi
}

wt_main_root() {
    d=$(git rev-parse --path-format=absolute --git-common-dir) || return 1
    if [ "$(git rev-parse --is-bare-repository)" = "true" ]; then
        printf '%s\n' "$d"
    else
        dirname "$d"
    fi
}

wta() {
    r=$(wt_repo_name) || return 1
    main_root=$(wt_main_root) || return 1
    target="$(dirname "$main_root")/$r.$1"
    git worktree add -b "$1" "$target" || return 1
    cd "$target" || return 1
}

wtr() {
    if [ "$#" -gt 1 ]; then
        printf '%s\n' "wtr: usage: wtr [branch]" >&2
        return 1
    fi

    r=$(wt_repo_name) || return 1
    main_root=$(wt_main_root) || return 1
    current_root=$(git rev-parse --show-toplevel 2>/dev/null || true)

    if [ "$#" -eq 1 ]; then
        branch=$1
        target="$(dirname "$main_root")/$r.$branch"
    else
        if [ -z "$current_root" ]; then
            printf '%s\n' "wtr: unable to determine the current worktree" >&2
            return 1
        fi

        branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null) || {
            printf '%s\n' "wtr: refusing to remove a detached HEAD worktree" >&2
            return 1
        }
        target=$current_root

        if [ "$target" = "$main_root" ]; then
            printf '%s\n' "wtr: refusing to remove the main worktree" >&2
            return 1
        fi
    fi

    if [ -n "$current_root" ] && [ "$current_root" = "$target" ]; then
        cd "$main_root" || return 1
    fi

    git worktree remove "$target" || return 1
    git -C "$main_root" branch -d "$branch"
}

wtj() {
    if ! command -v fzf >/dev/null 2>&1; then
        printf '%s\n' "wtj: fzf is not installed" >&2
        return 1
    fi

    current_root=$(git rev-parse --show-toplevel 2>/dev/null) || return 1
    main_root=$(wt_main_root) || return 1
    repo_name=$(wt_repo_name) || return 1
    tab=$(printf '\t')
    helper=$(mktemp "${TMPDIR:-/tmp}/wtj.XXXXXX") || return 1
    cat >"$helper" <<'EOF'
#!/bin/sh

set -eu

list_worktrees() {
    current_root=$1
    repo_name=$2

    git worktree list --porcelain |
        while IFS= read -r line || [ -n "$line" ]; do
            case "$line" in
                "worktree "*) path=${line#worktree }
                    branch='-'
                    ;;
                "branch "*) branch=${line#branch refs/heads/}
                    ;;
                detached) branch='detached'
                    ;;
                '')
                    if [ -n "${path:-}" ]; then
                        name=$(basename "$path")
                        case "$name" in
                            "$repo_name".*) name=${name#"$repo_name".}
                                ;;
                        esac
                        current_marker='  '
                        if [ "$path" = "$current_root" ]; then
                            current_marker='* '
                        fi

                        dirty_marker='-'
                        if [ -n "$(git -C "$path" status --porcelain 2>/dev/null)" ]; then
                            dirty_marker='D'
                        fi

                        printf '%s\t%s %s [%s] %s\n' "$path" "$dirty_marker" "$current_marker" "$branch" "$name"
                    fi
                    path=
                    branch='-'
                    ;;
            esac
        done
}

remove_worktree() {
    target=$1
    current_root=$2
    main_root=$3

    [ -n "$target" ] || exit 1

    if [ "$target" = "$main_root" ]; then
        printf '%s\n' "wtj: refusing to remove the main worktree" >&2
        exit 1
    fi

    if [ "$target" = "$current_root" ]; then
        printf '%s\n' "wtj: refusing to remove the current worktree from the picker" >&2
        exit 1
    fi

    branch=$(git -C "$target" symbolic-ref --quiet --short HEAD 2>/dev/null || true)
    git worktree remove "$target" >/dev/null || exit 1

    if [ -n "$branch" ]; then
        git -C "$main_root" branch -d "$branch" >/dev/null 2>&1 || true
    fi
}

case "${1:-}" in
    list)
        shift
        list_worktrees "$@"
        ;;
    remove)
        shift
        remove_worktree "$@"
        ;;
    *)
        printf '%s\n' "wtj helper: expected list|remove" >&2
        exit 1
        ;;
esac
EOF
    chmod +x "$helper" || {
        rm -f "$helper"
        return 1
    }
    choice=$(
        "$helper" list "$current_root" "$repo_name" |
            fzf --height=40% --delimiter="$tab" --with-nth=2.. --reverse --prompt='worktree> ' \
                --header='enter: cd, ctrl-x: remove worktree' \
                --bind "ctrl-x:execute-silent($helper remove {1} '$current_root' '$main_root')+reload($helper list '$current_root' '$repo_name')" \
                --exit-0
    )
    status=$?
    rm -f "$helper"
    [ "$status" -eq 0 ] || return 0
    [ -n "$choice" ] || return 0

    IFS="$tab" read -r target _ << EOF
$choice
EOF
    [ -n "$target" ] || return 0
    cd "$target" || return 1
}

wtl() {
    wtj "$@"
}

js_pick_path() {
    if ! command -v zoxide >/dev/null 2>&1; then
        printf '%s\n' "js: zoxide is not installed" >&2
        return 1
    fi

    zoxide query -i
}

js_session_root() {
    if git_root=$(git -C "$1" rev-parse --show-toplevel 2>/dev/null); then
        printf '%s\n' "$git_root"
    else
        printf '%s\n' "$1"
    fi
}

js_session_name() {
    basename -- "$1" | tr -c '[:alnum:]_-' '_'
}

js() {
    if ! command -v tmux >/dev/null 2>&1; then
        printf '%s\n' "js: tmux is not installed" >&2
        return 1
    fi

    selected_path=$(js_pick_path) || return 1
    [ -n "$selected_path" ] || return 0

    session_root=$(js_session_root "$selected_path")
    session_name=$(js_session_name "$session_root")
    [ -n "$session_name" ] || return 1

    session_cmd=
    case "$session_root" in
        *.review)
            session_cmd='exec gh dash'
            ;;
    esac

    if tmux has-session -t "=$session_name" 2>/dev/null; then
        if [ -n "${TMUX-}" ]; then
            tmux switch-client -t "=$session_name"
        else
            exec tmux attach-session -t "=$session_name"
        fi
        return 0
    fi

    if [ -n "${TMUX-}" ]; then
        if [ -n "$session_cmd" ]; then
            tmux new-session -d -s "$session_name" -c "$session_root" "$session_cmd"
        else
            tmux new-session -d -s "$session_name" -c "$session_root"
        fi
        tmux switch-client -t "=$session_name"
        return 0
    fi

    if [ -n "$session_cmd" ]; then
        exec tmux new-session -s "$session_name" -c "$session_root" "$session_cmd"
    fi

    exec tmux new-session -s "$session_name" -c "$session_root"
}

d2() {
    if [ "$#" -ne 2 ]; then
        printf '%s\n' "d2: usage: d2 <file-a> <file-b>" >&2
        return 1
    fi

    if ! command -v git >/dev/null 2>&1; then
        printf '%s\n' "d2: git is not installed" >&2
        return 1
    fi

    if command -v diffnav >/dev/null 2>&1; then
        diffnav_command=$(command -v diffnav)
    else
        printf '%s\n' "d2: diffnav is not installed" >&2
        return 1
    fi

    git diff --no-index --quiet -- "$1" "$2"
    diff_status=$?
    case "$diff_status" in
        0)
            printf '%s\n' "d2: no differences"
            return 0
            ;;
        1)
            ;;
        *)
            return "$diff_status"
            ;;
    esac

    git diff --no-index --no-ext-diff -- "$1" "$2" | "$diffnav_command"
}

