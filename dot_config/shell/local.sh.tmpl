{{- $shell := (get . "shell") | default dict -}}
{{- if or (get $shell "bash" | default false) (get $shell "zsh" | default false) -}}
# Shared shell customizations sourced from enterprise-managed shell rc files.
if [ -x "$HOME/.local/bin/kak-tmux-session" ]; then
    export EDITOR="$HOME/.local/bin/kak-tmux-session"
    export GIT_EDITOR="$HOME/.local/bin/kak-tmux-session"
    k() {
        "$HOME/.local/bin/kak-tmux-session" "$@"
    }
fi

if [ -x "$HOME/.local/bin/kak-picker-files" ]; then
    kff() {
        "$HOME/.local/bin/kak-picker-files" "$@"
    }
fi

if [ -x "$HOME/.local/bin/kak-picker-grep" ]; then
    kfg() {
        "$HOME/.local/bin/kak-picker-grep" "$@"
    }
fi

if [ -x "$HOME/.local/bin/kak-picker-directories" ]; then
    kfd() {
        "$HOME/.local/bin/kak-picker-directories" "$@"
    }
fi

if [ -x "$HOME/.local/bin/kak-note-todo" ]; then
    knt() {
        "$HOME/.local/bin/kak-note-todo" "$@"
    }
fi

if [ -x "$HOME/.local/bin/kak-note-list" ]; then
    knf() {
        "$HOME/.local/bin/kak-note-list" "$@"
    }
fi

if [ -x "$HOME/.local/bin/kak-note-grep" ]; then
    kng() {
        "$HOME/.local/bin/kak-note-grep" "$@"
    }
fi

if [ -x "$HOME/.local/bin/kak-task-menu" ]; then
    ktt() {
        "$HOME/.local/bin/kak-task-menu" "$@"
    }
fi

wta() {
    d=$(git rev-parse --path-format=absolute --git-common-dir)
    if [ "$(git rev-parse --is-bare-repository)" = "true" ]; then
        r=$(basename "$d" .git)
    else
        r=$(basename "$(dirname "$d")")
    fi
    git worktree add -b "$1" "../$r.$1"
}

wtr() {
    d=$(git rev-parse --path-format=absolute --git-common-dir)
    if [ "$(git rev-parse --is-bare-repository)" = "true" ]; then
        r=$(basename "$d" .git)
    else
        r=$(basename "$(dirname "$d")")
    fi
    git worktree remove "../$r.$1"
}

wtl() {
    git worktree list
}

js_pick_path() {
    if ! command -v zoxide >/dev/null 2>&1; then
        printf '%s\n' "js: zoxide is not installed" >&2
        return 1
    fi

    zoxide query -i
}

js_session_root() {
    if git_root=$(git -C "$1" rev-parse --show-toplevel 2>/dev/null); then
        printf '%s\n' "$git_root"
    else
        printf '%s\n' "$1"
    fi
}

js_session_name() {
    basename -- "$1" | tr -c '[:alnum:]_-' '_'
}

js() {
    if ! command -v tmux >/dev/null 2>&1; then
        printf '%s\n' "js: tmux is not installed" >&2
        return 1
    fi

    selected_path=$(js_pick_path) || return 1
    [ -n "$selected_path" ] || return 0

    session_root=$(js_session_root "$selected_path")
    session_name=$(js_session_name "$session_root")
    [ -n "$session_name" ] || return 1

    session_cmd=
    case "$session_root" in
        *.review)
            session_cmd='exec gh dash'
            ;;
    esac

    if tmux has-session -t "=$session_name" 2>/dev/null; then
        if [ -n "${TMUX-}" ]; then
            tmux switch-client -t "=$session_name"
        else
            exec tmux attach-session -t "=$session_name"
        fi
        return 0
    fi

    if [ -n "${TMUX-}" ]; then
        if [ -n "$session_cmd" ]; then
            tmux new-session -d -s "$session_name" -c "$session_root" "$session_cmd"
        else
            tmux new-session -d -s "$session_name" -c "$session_root"
        fi
        tmux switch-client -t "=$session_name"
        return 0
    fi

    if [ -n "$session_cmd" ]; then
        exec tmux new-session -s "$session_name" -c "$session_root" "$session_cmd"
    fi

    exec tmux new-session -s "$session_name" -c "$session_root"
}

if [ -n "${ZSH_VERSION-}" ]; then
    PROMPT=$'%F{blue}%~%f\n%# '
elif [ -n "${BASH_VERSION-}" ]; then
    PS1='\[\e[34m\]\w\[\e[0m\]\n\$ '
fi
{{- end -}}
