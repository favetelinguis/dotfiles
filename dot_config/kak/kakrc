colorscheme zenburn-alabaster
set-option global startup_info_version 99999999

map -docstring "yank the selection into the clipboard" global user y ':clipboard-copy<ret>'
map -docstring "paste the clipboard" global user p ':clipboard-paste<ret>'

# Always keep one line and three columns displayed around the cursor
set-option global scrolloff 1,3

set-option global modelinefmt '%val{cursor_line}:%val{cursor_char_column}/%val{buf_line_count} {{mode_info}} {magenta}%val{client}{default} {cyan}%val{bufname}{default} {{context_info}}'

eval %sh{kak-lsp}
map global user l ':enter-user-mode lsp<ret>' -docstring 'LSP mode'
map global user . ':enter-user-mode chezmoi<ret>' -docstring 'chezmoi'
map global user f ':enter-user-mode fzf<ret>' -docstring 'fzf'
map global user n ':enter-user-mode note<ret>' -docstring 'notes'
map global user r ':enter-user-mode gh<ret>' -docstring 'review'
map global user v ':enter-user-mode git<ret>' -docstring 'git'
map global user t ':enter-user-mode task<ret>' -docstring 'tasks'
map global user u ':enter-user-mode utility<ret>' -docstring 'utility'
map global user w ':enter-user-mode window<ret>' -docstring 'window'

map global user a ':agent-send<ret>'     -docstring 'send selection to Claude/Codex'
map global user A ':agent-send-submit<ret>' -docstring 'send to Claude/Codex and submit'

try %{ declare-user-mode window }
try %{ declare-user-mode task }
try %{ declare-user-mode fzf }
try %{ declare-user-mode gh }
try %{ declare-user-mode note }
try %{ declare-user-mode utility }
map global window d ':split<ret>'  -docstring 'split below'
map global window s ':vsplit<ret>' -docstring 'split right'
map global window t ':tabnew<ret>' -docstring 'new tmux window'

map global fzf f ':fzf-files<ret>'       -docstring 'files'
map global fzf E ':lf-files<ret>'        -docstring 'lf explorer'
map global fzf b ':fzf-buffers<ret>'     -docstring 'buffers'
map global fzf g ':fzf-grep<ret>'        -docstring 'grep'
map global fzf d ':fzf-directories<ret>' -docstring 'directories'

map global gh d ':gh-pr-diff<ret>'                  -docstring 'open PR diff'
map global gh e ':gh-pr-files<ret>'                 -docstring 'changed files tree'
map global gh f ':gh-pr-files-fzf<ret>'             -docstring 'changed files fuzzy'
map global gh o ':gh-diff-open-working-tree-file<ret>' -docstring 'open worktree file'
map global gh r ':gh-pr-refresh<ret>'               -docstring 'refresh review'
map global gh w ':gh-pr-view-web<ret>'              -docstring 'open PR in browser'
map global gh '[' ':gh-prev-hunk<ret>'              -docstring 'previous hunk'
map global gh ']' ':gh-next-hunk<ret>'              -docstring 'next hunk'

map global note n ':note-create<ret>'         -docstring 'create note'
map global note t ':note-todo-open<ret>'      -docstring 'open todo'
map global note f ':note-list<ret>'           -docstring 'list notes'
map global note g ':note-grep<ret>'           -docstring 'grep notes'
map global note v ':note-history-grep-file<ret>' -docstring 'grep current note history'
map global note V ':note-history-grep-all<ret>'  -docstring 'grep notes history'
map global note X ':note-delete-current<ret>' -docstring 'delete note'

map global task t ':task-menu<ret>'              -docstring 'task menu'
map global task r ':task-rerun<ret>'             -docstring 'rerun last task'
map global task o ':task-open-last-output<ret>'  -docstring 'open last output'
map global task n ':task-next-error<ret>'        -docstring 'next task error'
map global task p ':task-previous-error<ret>'    -docstring 'previous task error'
map global task x ':task-cancel<ret>'            -docstring 'cancel running task'
map global task f ':task-find<ret>'              -docstring 'find running tasks'

map global utility t ':utility-jwt-decode-cursor<ret>' -docstring 'decode jwt'
