{{- $data := (get . "data") | default dict -}}
{{- $apps := (get $data "apps") | default dict -}}
{{- $agent := (get $data "agent") | default dict -}}
# Machine-local chezmoi configuration.
# All values default to false so a new machine starts with nothing enabled.
# Edit ~/.config/chezmoi/chezmoi.toml after `chezmoi init`, then run
# `chezmoi apply` to install only the pieces you want on this machine.

[data.apps]
foot = {{ get $apps "foot" | default false }}
fuzzel = {{ get $apps "fuzzel" | default false }}
mako = {{ get $apps "mako" | default false }}
niri = {{ get $apps "niri" | default false }}
swaylock = {{ get $apps "swaylock" | default false }}
ghostty = {{ get $apps "ghostty" | default false }}
kak = {{ get $apps "kak" | default false }}
tmux = {{ get $apps "tmux" | default false }}
kak_task_scripts = {{ get $apps "kak_task_scripts" | default false }}
lf = {{ get $apps "lf" | default false }}
lazygit = {{ get $apps "lazygit" | default false }}
gitui = {{ get $apps "gitui" | default false }}
emacs = {{ get $apps "emacs" | default false }}

[data.agent]
codex = {{ get $agent "codex" | default false }}
claude = {{ get $agent "claude" | default false }}
opencode = {{ get $agent "opencode" | default false }}
