#!/bin/sh

set -eu

config_dir=${XDG_CONFIG_HOME:-"$HOME/.config"}
config_file=$config_dir/delta/config.gitconfig

if [ ! -f "$config_file" ]; then
    exec diffnav "$@"
fi

tmp_home=$(mktemp -d "${TMPDIR:-/tmp}/diffnav-zenburn.XXXXXX")

cleanup() {
    rm -rf "$tmp_home"
}

trap cleanup EXIT HUP INT TERM

ln -s "$config_file" "$tmp_home/.gitconfig"

HOME=$tmp_home XDG_CONFIG_HOME=$config_dir diffnav "$@"
status=$?
exit "$status"
