
#!/bin/sh

set -eu

kak_bin=$(which kak)
startup_cmd=

sanitize_name() {
    printf '%s' "$1" | tr -c '[:alnum:]_.-' '_'
}

kakquote() {
    printf "'%s'" "$(printf '%s' "$1" | sed "s/'/''/g")"
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --cmd)
            [ "$#" -ge 2 ] || {
                printf '%s\n' 'kak-tmux-session: --cmd requires an argument' >&2
                exit 1
            }
            startup_cmd=$2
            shift 2
            ;;
        *)
            break
            ;;
    esac
done

passthrough=false
for arg in "$@"; do
    case "$arg" in
        -c|-s|-p|-l|-clear|-help|-version|-ui|-d)
            passthrough=true
            break
            ;;
    esac
done

if [ "$passthrough" = true ]; then
    [ -z "$startup_cmd" ] || {
        printf '%s\n' 'kak-tmux-session: --cmd cannot be combined with raw Kakoune session flags' >&2
        exit 1
    }
    exec "$kak_bin" "$@"
fi

if [ "$#" -eq 2 ]; then
    case "$1" in
        +[0-9]*)
            line=${1#+}
            path=$2
            set -- -e "edit -existing $(kakquote "$path") $line"
            ;;
    esac
fi

if [ -n "${KAK_CLIENT_NAME:-}" ]; then
    client_name=$(sanitize_name "$KAK_CLIENT_NAME")
    set -- -e "rename-client $client_name" "$@"
fi

if [ -n "$startup_cmd" ]; then
    set -- "$@" -e "$startup_cmd"
fi

if [ -n "${TMUX:-}" ] && command -v tmux >/dev/null 2>&1; then
    session_id=$(tmux display-message -p '#{session_id}' 2>/dev/null || true)
    if [ -n "$session_id" ]; then
        kak_session=${session_id#\$}
        kak_session=$(sanitize_name "$kak_session")
        if [ -n "$kak_session" ]; then
            if "$kak_bin" -l 2>/dev/null | grep -Fxq "$kak_session"; then
                exec "$kak_bin" -c "$kak_session" "$@"
            fi
            exec "$kak_bin" -s "$kak_session" "$@"
        fi
    fi
fi

exec "$kak_bin" "$@"
