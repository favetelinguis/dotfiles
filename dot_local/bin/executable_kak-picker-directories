#!/bin/sh

set -eu

root=${1:-$PWD}
open_helper="${HOME}/.local/bin/kak-picker-open"

cd "$root" || exit 1

result=$(
    (fd --type d 2>/dev/null || find . -type d | sed '/^\.$/d') | \
        fzf --height=40% --reverse --prompt 'dirs> '
)

[ -n "$result" ] || exit 0
exec "$open_helper" directory "$result"
