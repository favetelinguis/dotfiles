{{- $github := (get . "github") | default dict -}}
{{- $globalPrFilterExtra := (get $github "globalPrFilter") | default "" | trim | trimPrefix "is:open" | trim -}}
#!/bin/sh

set -eu

tab=$(printf '\t')

usage() {
    printf '%s\n' 'usage: jrg'
}

require_command() {
    command -v "$1" >/dev/null 2>&1 || {
        printf 'jrg: %s is not installed\n' "$1" >&2
        exit 1
    }
}

expand_path() {
    case $1 in
        "~")
            printf '%s\n' "$HOME"
            ;;
        "~/"*)
            printf '%s/%s\n' "$HOME" "${1#"~/"}"
            ;;
        *)
            printf '%s\n' "$1"
            ;;
    esac
}

repo_path=$(cat <<'EOF'
{{ get $github "repoPath" | default "" }}
EOF
)

global_pr_filter=$(cat <<'EOF'
{{ if $globalPrFilterExtra }}{{ printf "is:open %s" $globalPrFilterExtra }}{{ else }}is:open{{ end }}
EOF
)

list_prs() {
    gh search prs \
        --limit "${JRG_LIMIT:-80}" \
        --json url,number,title,author,updatedAt,isDraft,state \
        --jq '.[] | [.url, ("#" + (.number | tostring)), (if .isDraft then "DRAFT" else .state end), .author.login, (.updatedAt[0:16] | gsub("T"; " ")), .title] | @tsv' \
        -- "$global_pr_filter"
}

format_pr_rows() {
    awk -F '\t' '
        BEGIN {
            printf "url\tpr\t%-8s  %-16s  %-16s  %-18s  %s\n", "state", "author", "updated", "size", "title"
        }
        {
            title = $6
            for (i = 7; i <= NF; i++) {
                title = title "\t" $i
            }
            gsub(/\t/, " ", title)
            printf "%s\t%s\t%-8s  %-16s  %-16s  %-18s  %s\n", $1, $2, $3, $4, $5, "-", title
        }
    '
}

parse_repo_from_url() {
    printf '%s\n' "$1" | awk -F '/' '
        NF >= 7 && $1 ~ /^https?:$/ && $3 != "" && $4 != "" && $5 != "" && $6 == "pull" {
            printf "%s\t%s\n", $4, $5
            exit
        }
    '
}

resolve_local_repo_root() {
    repo_owner=$1
    repo_name=$2

    [ -n "$repo_path" ] || {
        printf '%s\n' 'jrg: github.repoPath is empty' >&2
        exit 1
    }

    repo_base=$(expand_path "$repo_path")
    [ -d "$repo_base" ] || {
        printf 'jrg: github.repoPath is not a directory: %s\n' "$repo_base" >&2
        exit 1
    }

    # Search .git entries one level deeper than the requested repo-root depth.
    matches=$(fd -HI -t d -t f -d 5 '^\.git$' "$repo_base" 2>/dev/null | while IFS= read -r git_entry; do
        candidate=$(dirname "$git_entry")
        if [ "$(basename "$candidate")" = "$repo_name" ]; then
            printf '%s\n' "$candidate"
        fi
    done | awk '!seen[$0]++')

    match_count=$(printf '%s\n' "$matches" | awk 'NF { count++ } END { print count + 0 }')

    case "$match_count" in
        0)
            printf 'jrg: unable to find a local checkout for %s/%s under %s (searched up to 4 levels deep)\n' \
                "$repo_owner" "$repo_name" "$repo_base" >&2
            exit 1
            ;;
        1)
            printf '%s\n' "$matches"
            ;;
        *)
            printf 'jrg: multiple local checkouts match %s/%s under %s:\n' \
                "$repo_owner" "$repo_name" "$repo_base" >&2
            printf '%s\n' "$matches" >&2
            exit 1
            ;;
    esac
}

pick_pr() {
    list_output=$(list_prs)

    if [ -z "$list_output" ]; then
        printf '%s\n' 'jrg: no pull requests matched github.globalPrFilter'
        exit 0
    fi

    selection=$(printf '%s\n' "$list_output" | format_pr_rows | fzf \
            --height=75% \
            --reverse \
            --prompt='pr> ' \
            --delimiter="$tab" \
            --with-nth=2.. \
            --header-lines=1 \
            --header='enter: open review window' \
            --exit-0) || exit 0

    [ -n "$selection" ] || exit 0

    IFS="$tab" read -r pr_url pr_number _ << EOF
$selection
EOF
    [ -n "$pr_url" ] || exit 1
    pr_number=${pr_number#\#}
    [ -n "$pr_number" ] || exit 1

    repo_metadata=$(parse_repo_from_url "$pr_url")
    [ -n "$repo_metadata" ] || {
        printf 'jrg: unable to parse GitHub repo from PR URL: %s\n' "$pr_url" >&2
        exit 1
    }

    IFS="$tab" read -r repo_owner repo_name << EOF
$repo_metadata
EOF
    [ -n "$repo_owner" ] || exit 1
    [ -n "$repo_name" ] || exit 1

    repo_root=$(resolve_local_repo_root "$repo_owner" "$repo_name")
    cd "$repo_root" || exit 1
    exec "$HOME/.local/bin/jr" --open "$pr_number"
}

case "${1:-}" in
    -h|--help)
        usage
        exit 0
        ;;
esac

[ "$#" -eq 0 ] || {
    usage >&2
    exit 1
}

require_command gh
require_command fzf
require_command fd

pick_pr
