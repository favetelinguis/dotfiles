#!/bin/sh

set -eu

usage() {
    printf '%s\n' "usage: jr [base-branch]" >&2
    printf '%s\n' "       jr --print0 [base-branch]" >&2
}

resolve_base() {
    if [ -n "${1:-}" ]; then
        printf '%s\n' "$1"
        return 0
    fi

    if [ -n "${JR_BASE:-}" ]; then
        printf '%s\n' "$JR_BASE"
        return 0
    fi

    ref=$(git symbolic-ref --quiet refs/remotes/origin/HEAD 2>/dev/null || true)
    if [ -n "$ref" ]; then
        printf '%s\n' "${ref#refs/remotes/origin/}"
        return 0
    fi

    for candidate in main master origin/main origin/master; do
        if git rev-parse --verify --quiet "${candidate}^{commit}" >/dev/null; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done

    return 1
}

mode=launch
case "${1:-}" in
    --print0)
        mode=print0
        shift
        ;;
    -h|--help)
        usage
        exit 0
        ;;
esac

if [ "$#" -gt 1 ]; then
    usage
    exit 1
fi

if ! command -v git >/dev/null 2>&1; then
    printf '%s\n' "jr: git is not installed" >&2
    exit 1
fi

if [ "$mode" = launch ] && ! command -v nnn >/dev/null 2>&1; then
    printf '%s\n' "jr: nnn is not installed" >&2
    exit 1
fi

repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || {
    printf '%s\n' "jr: not inside a git work tree" >&2
    exit 1
}

cd "$repo_root" || exit 1

base=$(resolve_base "${1:-}") || {
    printf '%s\n' "jr: unable to determine a base branch; pass one explicitly" >&2
    exit 1
}

git rev-parse --verify --quiet "${base}^{commit}" >/dev/null || {
    printf 'jr: base revision not found: %s\n' "$base" >&2
    exit 1
}

if [ "$mode" = print0 ]; then
    exec git diff --name-only -z "${base}...HEAD"
fi

tmp_file=$(mktemp "${TMPDIR:-/tmp}/jr.XXXXXX")
trap 'rm -f "$tmp_file"' EXIT HUP INT TERM

git diff --name-only -z "${base}...HEAD" > "$tmp_file"

if [ ! -s "$tmp_file" ]; then
    printf 'jr: no changed files between HEAD and %s\n' "$base"
    exit 0
fi

exec nnn < "$tmp_file"
