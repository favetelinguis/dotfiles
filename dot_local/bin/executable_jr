#!/bin/sh

set -eu

tab=$(printf '\t')

usage() {
    printf '%s\n' 'usage: jr'
    printf '%s\n' '       jr --show <pull-request>'
    printf '%s\n' '       jr --open <pull-request>'
    printf '%s\n' '       jr --window <pull-request>'
}

require_command() {
    command -v "$1" >/dev/null 2>&1 || {
        printf 'jr: %s is not installed\n' "$1" >&2
        exit 1
    }
}

resolve_repo_root() {
    git rev-parse --show-toplevel 2>/dev/null || {
        printf '%s\n' 'jr: not inside a git work tree' >&2
        exit 1
    }
}

resolve_repo_name() {
    git_common_dir=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || {
        printf '%s\n' 'jr: unable to determine git common dir' >&2
        exit 1
    }

    if [ "$(git rev-parse --is-bare-repository 2>/dev/null)" = "true" ]; then
        basename "$git_common_dir" .git
    else
        basename "$(dirname "$git_common_dir")"
    fi
}

resolve_repo_identity() {
    remote_url=$(git config --get remote.origin.url 2>/dev/null || true)
    [ -n "$remote_url" ] || {
        printf '%s\n' 'jr: unable to determine remote.origin.url' >&2
        exit 1
    }

    case "$remote_url" in
        git@*:* )
            remote_path=${remote_url#*:}
            ;;
        ssh://git@*/*)
            remote_path=${remote_url#ssh://git@*/}
            ;;
        https://*/*|http://*/*|git://*/*)
            remote_path=${remote_url#*://*/}
            ;;
        *)
            printf 'jr: unsupported remote URL: %s\n' "$remote_url" >&2
            exit 1
            ;;
    esac

    remote_path=${remote_path%.git}
    owner=${remote_path%%/*}
    repo=${remote_path#*/}
    repo=${repo%%/*}

    [ -n "$owner" ] && [ -n "$repo" ] || {
        printf 'jr: unable to parse GitHub repo from remote URL: %s\n' "$remote_url" >&2
        exit 1
    }

    printf '%s\t%s\n' "$owner" "$repo"
}

encode_review_component() {
    printf '%s' "$1" | base64 | tr -d '\n=' | tr '/+' '_-'
}

review_worktree_path() {
    pr_number=$1
    author_login=$2
    head_ref=$3
    head_ref_encoded=$(encode_review_component "$head_ref")

    printf '%s/gh__%s__%s__PR%s__%s__%s\n' \
        "${JR_REVIEWS_ROOT:-$HOME/.reviews}" \
        "$repo_owner" \
        "$repo_short_name" \
        "$pr_number" \
        "$author_login" \
        "$head_ref_encoded"
}

legacy_review_worktree_path() {
    printf '%s/%s.PR%s\n' "${JR_REVIEWS_ROOT:-$HOME/.reviews}" "$repo_name" "$1"
}

find_existing_review_worktree() {
    pr_number=$1
    head_ref=${2:-}
    reviews_root=${JR_REVIEWS_ROOT:-$HOME/.reviews}

    for candidate in \
        "$reviews_root"/gh__"${repo_owner}"__"${repo_short_name}"__PR"${pr_number}"__* \
        "$(legacy_review_worktree_path "$pr_number")"
    do
        [ -e "$candidate" ] || continue
        if git -C "$candidate" rev-parse --show-toplevel >/dev/null 2>&1; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done

    if [ -n "$head_ref" ]; then
        wt=$(git worktree list --porcelain | awk -v ref="refs/heads/$head_ref" '
            /^worktree /{wt=substr($0,10)} /^branch /{if($2==ref){print wt;exit)}
        ')
         if [ -n "$wt" ]; then
             printf '%s\n' "$wt"
             return 0
         fi
    fi


    return 1
}

list_prs() {
    gh pr list \
        --limit "${JR_LIMIT:-80}" \
        --state open \
        --json number,title,author,updatedAt,isDraft,reviewDecision,changedFiles,additions,deletions,headRefName \
        --template '{{range .}}{{printf "#%v\t" .number}}{{if .isDraft}}DRAFT{{else if eq .reviewDecision "APPROVED"}}APPROVED{{else if eq .reviewDecision "CHANGES_REQUESTED"}}CHANGES{{else if eq .reviewDecision "REVIEW_REQUIRED"}}REVIEW{{else}}OPEN{{end}}{{printf "\t%s\t%s\t%v\t%v\t%v\t%s\t%s\n" .author.login (timefmt "2006-01-02 15:04" .updatedAt) .changedFiles .additions .deletions .headRefName .title}}{{end}}'
}

format_pr_rows() {
    awk -F '\t' '
        BEGIN {
            printf "pr\t%-8s  %-16s  %-16s  %-18s  %s\n", "state", "author", "updated", "size", "title"
        }
        {
            title = $9
            for (i = 10; i <= NF; i++) {
                title = title "\t" $i
            }
            gsub(/\t/, " ", title)
            size = $5 "f +" $6 "/-" $7
            printf "%s\t%-8s  %-16s  %-16s  %-18s  %s\n", $1, $2, $3, $4, size, title
        }
    '
}

lookup_pr_metadata() {
    pr_number=$1
    list_output=$2

    printf '%s\n' "$list_output" | awk -F '\t' -v target="#$pr_number" '
        $1 == target {
            printf "%s\t%s\n", $3, $8
            exit
        }
    '
}

fetch_pr_metadata() {
    gh pr view "$1" \
        --json author,headRefName \
        --template '{{printf "%s\t%s\n" .author.login .headRefName}}'
}

review_session_name() {
    worktree_path=$1
    worktree_name=$(basename -- "$worktree_path")
    sanitize_session_component() {
        printf '%s' "$1" | tr -c '[:alnum:]_-' '_'
    }

    case "$worktree_name" in
        gh__*__*__PR*__*__*)
            session_repo_owner=${worktree_name#gh__}
            session_repo_owner=${session_repo_owner%%__*}
            session_rest=${worktree_name#gh__"${session_repo_owner}"__}
            session_repo_name=${session_rest%%__*}
            session_rest=${session_rest#"${session_repo_name}"__}
            session_pr=${session_rest%%__*}
            printf 'review__%s__%s__%s\n' \
                "$(sanitize_session_component "$session_repo_owner")" \
                "$(sanitize_session_component "$session_repo_name")" \
                "$(sanitize_session_component "$session_pr")"
            return 0
            ;;
    esac

    printf 'review__%s\n' "$(sanitize_session_component "$worktree_name")"
}

update_review_checkout() {
    pr_number=$1
    worktree_path=$2
    (
        cd "$worktree_path" || exit 1
        gh pr checkout "$pr_number" --force >/dev/null
    )
}

ensure_review_worktree() {
    pr_number=$1
    author_login=${2:-}
    head_ref=${3:-}
    reviews_root=${JR_REVIEWS_ROOT:-$HOME/.reviews}

    mkdir -p "$reviews_root"

    worktree_path=$(find_existing_review_worktree "$pr_number" "$head_ref" 2>/dev/null || true)
    if [ -z "$worktree_path" ]; then
        [ -n "$author_login" ] && [ -n "$head_ref" ] || {
            printf 'jr: missing review metadata for pull request %s\n' "$pr_number" >&2
            exit 1
        }
        worktree_path=$(review_worktree_path "$pr_number" "$author_login" "$head_ref")
    fi

    if [ -e "$worktree_path" ] && ! git -C "$worktree_path" rev-parse --show-toplevel >/dev/null 2>&1; then
        printf 'jr: review path exists and is not a git worktree: %s\n' "$worktree_path" >&2
        exit 1
    fi

    if git -C "$worktree_path" rev-parse --show-toplevel >/dev/null 2>&1; then
        if [ -n "$(git -C "$worktree_path" status --porcelain 2>/dev/null)" ]; then
            printf 'jr: review worktree has local changes: %s\n' "$worktree_path" >&2
            exit 1
        fi

        git -C "$worktree_path" pull --ff-only >/dev/null 2>&1 || true
        update_review_checkout "$pr_number" "$worktree_path" || exit 1
        printf '%s\n' "$worktree_path"
        return 0
    fi

    git worktree add --detach "$worktree_path" >/dev/null
    if ! update_review_checkout "$pr_number" "$worktree_path"; then
        git worktree remove --force "$worktree_path" >/dev/null 2>&1 || true
        exit 1
    fi

    printf '%s\n' "$worktree_path"
}

status_pane_command() {
    pr_number=$1
    printf '%s\n' "sh -lc '\"$HOME/.local/bin/jr\" --show $pr_number </dev/null; status=\$?; if [ \"\$status\" -ne 0 ]; then printf \"%s\\n\" \"jr: status pane command exited with status \$status\"; fi; exec \"\${SHELL:-/bin/sh}\" -i'"
}

kak_picker_pane_command() {
    printf '%s\n' "exec \"$HOME/.local/bin/kak-tmux-session\" --cmd gh-pr-files"
}

setup_review_window() {
    pr_number=$1
    current_pane=$(tmux display-message -p '#{pane_id}')
    tmux split-window -d -h -P -F '#{pane_id}' -t "$current_pane" -c "$PWD" "$(status_pane_command "$pr_number")" >/dev/null
    tmux select-pane -t "$current_pane"
    exec sh -lc "$(kak_picker_pane_command)"
}

open_review_window() {
    pr_number=$1
    author_login=${2:-}
    head_ref=${3:-}
    worktree_path=$(ensure_review_worktree "$pr_number" "$author_login" "$head_ref")

    if [ -z "${TMUX:-}" ] || ! command -v tmux >/dev/null 2>&1; then
        if command -v tmux >/dev/null 2>&1; then
            review_command=$(printf 'exec "%s" --window %s' "$HOME/.local/bin/jr" "$pr_number")
            session_name=$(review_session_name "$worktree_path")

            if tmux has-session -t "=$session_name" 2>/dev/null; then
                tmux select-window -t "=$session_name:1" >/dev/null 2>&1 || true
                exec tmux attach-session -t "=$session_name"
            fi

            exec tmux new-session -s "$session_name" -n 1 -c "$worktree_path" "$review_command"
        fi

        cd "$worktree_path" || exit 1
        exec "$0" --show "$pr_number"
    fi

    review_command=$(printf 'exec "%s" --window %s' "$HOME/.local/bin/jr" "$pr_number")
    session_name=$(review_session_name "$worktree_path")

    if tmux has-session -t "=$session_name" 2>/dev/null; then
        tmux select-window -t "=$session_name:1" >/dev/null 2>&1 || true
        tmux switch-client -t "=$session_name"
        return 0
    fi

    new_session_output=''
    if ! new_session_output=$(tmux new-session -d -s "$session_name" -n 1 -c "$worktree_path" "$review_command" 2>&1); then
        tmux has-session -t "=$session_name" 2>/dev/null || {
            [ -n "$new_session_output" ] && printf '%s\n' "$new_session_output" >&2
            exit 1
        }
    fi
    tmux switch-client -t "=$session_name"
}

open_pr() {
    pr_number=$1
    metadata=$(fetch_pr_metadata "$pr_number" 2>/dev/null || true)
    [ -n "$metadata" ] || {
        printf 'jr: unable to fetch metadata for pull request %s\n' "$pr_number" >&2
        exit 1
    }

    IFS="$tab" read -r author_login head_ref << EOF
$metadata
EOF
    [ -n "$author_login" ] || {
        printf 'jr: missing author metadata for pull request %s\n' "$pr_number" >&2
        exit 1
    }
    [ -n "$head_ref" ] || {
        printf 'jr: missing head branch metadata for pull request %s\n' "$pr_number" >&2
        exit 1
    }

    open_review_window "$pr_number" "$author_login" "$head_ref"
}

render_pr_summary() {
    gh pr view "$1" \
        --json additions,assignees,author,baseRefName,changedFiles,commits,createdAt,deletions,headRefName,isDraft,labels,latestReviews,mergeStateStatus,mergeable,number,reviewDecision,state,title,updatedAt,url \
        --template '{{printf "#%v %s\n\n" .number .title}}{{printf "URL: %s\n" .url}}{{printf "State: %s" .state}}{{if .isDraft}}{{printf " (draft)"}}{{end}}{{printf "\n"}}{{printf "Author: %s\n" .author.login}}{{printf "Branches: %s -> %s\n" .headRefName .baseRefName}}{{printf "Review: "}}{{if .reviewDecision}}{{printf "%s" .reviewDecision}}{{else}}{{printf "NONE"}}{{end}}{{printf "\n"}}{{printf "Merge: %s / %s\n" .mergeable .mergeStateStatus}}{{printf "Updated: %s\n" (timefmt "2006-01-02 15:04 MST" .updatedAt)}}{{printf "Created: %s\n" (timefmt "2006-01-02 15:04 MST" .createdAt)}}{{printf "Changes: %v commits, %v files, +%v -%v\n" (len .commits) .changedFiles .additions .deletions}}{{if .labels}}{{printf "Labels: "}}{{range $i, $label := .labels}}{{if $i}}{{printf ", "}}{{end}}{{printf "%s" $label.name}}{{end}}{{printf "\n"}}{{end}}{{if .assignees}}{{printf "Assignees: "}}{{range $i, $assignee := .assignees}}{{if $i}}{{printf ", "}}{{end}}{{printf "%s" $assignee.login}}{{end}}{{printf "\n"}}{{end}}{{if .latestReviews}}{{printf "Latest reviews: "}}{{range $i, $review := .latestReviews}}{{if $i}}{{printf ", "}}{{end}}{{printf "%s:%s" $review.author.login $review.state}}{{end}}{{printf "\n"}}{{end}}'
}

render_pr_checks() {
    output=''
    if output=$(gh pr checks "$1" \
        --json bucket,name,workflow \
        --template '{{if .}}{{tablerow "bucket" "workflow" "check"}}{{range .}}{{tablerow .bucket .workflow .name}}{{end}}{{tablerender}}{{else}}No reported checks.{{end}}' 2>&1); then
        :
    else
        status=$?
        if [ "$status" -ne 8 ]; then
            printf 'Checks unavailable: %s\n' "$output"
            return 0
        fi
    fi

    if [ -n "$output" ]; then
        printf '%s\n' "$output"
    else
        printf '%s\n' 'No reported checks.'
    fi
}

render_pr_body() {
    gh pr view "$1" --json body --template '{{if .body}}{{.body}}{{else}}(no description){{end}}'
}

render_pr_once() {
    pr_number=$1

    render_pr_summary "$pr_number"
    printf '\n%s\n%s\n' 'Checks' '------'
    render_pr_checks "$pr_number"
    printf '\n%s\n%s\n' 'Description' '-----------'
    render_pr_body "$pr_number"
}

pick_pr() {
    list_output=$(list_prs)

    if [ -z "$list_output" ]; then
        printf '%s\n' 'jr: no open pull requests'
        exit 0
    fi

    selection=$(printf '%s\n' "$list_output" | format_pr_rows | fzf \
            --height=75% \
            --reverse \
            --prompt='pr> ' \
            --delimiter="$tab" \
            --with-nth=2 \
            --header-lines=1 \
            --header='enter: open review window' \
            --exit-0) || exit 0

    [ -n "$selection" ] || exit 0

    IFS="$tab" read -r pr_number _ << EOF
$selection
EOF
    pr_number=${pr_number#\#}
    [ -n "$pr_number" ] || exit 1
    metadata=$(lookup_pr_metadata "$pr_number" "$list_output")
    IFS="$tab" read -r author_login head_ref << EOF
$metadata
EOF
    [ -n "$author_login" ] || exit 1
    [ -n "$head_ref" ] || exit 1

    open_review_window "$pr_number" "$author_login" "$head_ref"
}

show_pr() {
    pr_number=$1

    if [ ! -t 0 ] || [ ! -t 1 ]; then
        render_pr_once "$pr_number"
        return 0
    fi

    while :; do
        printf '\033[H\033[2J'
        render_pr_once "$pr_number"
        printf '\n%s' '[r] refresh  [o] open in browser  [q] quit > '

        if ! IFS= read -r choice; then
            exit 0
        fi

        case $choice in
            q|Q|quit|exit)
                exit 0
                ;;
            o|O|open|web)
                gh pr view "$pr_number" --web >/dev/null 2>&1 || true
                ;;
            *)
                ;;
        esac
    done
}

mode=pick
case "${1:-}" in
    --show)
        mode=show
        shift
        ;;
    --open)
        mode=open
        shift
        ;;
    --window)
        mode=window
        shift
        ;;
    -h|--help)
        usage
        exit 0
        ;;
esac

case "$mode" in
    pick)
        [ "$#" -eq 0 ] || {
            usage >&2
            exit 1
        }
        ;;
    show)
        [ "$#" -eq 1 ] || {
            usage >&2
            exit 1
        }
        ;;
    open)
        [ "$#" -eq 1 ] || {
            usage >&2
            exit 1
        }
        ;;
    window)
        [ "$#" -eq 1 ] || {
            usage >&2
            exit 1
        }
        ;;
esac

require_command git
require_command gh
require_command base64

if [ "$mode" = pick ]; then
    require_command fzf
fi

repo_root=$(resolve_repo_root)
repo_name=$(resolve_repo_name)
IFS="$tab" read -r repo_owner repo_short_name << EOF
$(resolve_repo_identity)
EOF
cd "$repo_root" || exit 1

case "$mode" in
    pick)
        pick_pr
        ;;
    show)
        show_pr "$1"
        ;;
    open)
        open_pr "$1"
        ;;
    window)
        require_command tmux
        setup_review_window "$1"
        ;;
esac
