#!/bin/sh

set -eu

command -v kak >/dev/null 2>&1 || {
    printf '%s\n' 'kak-broot-open: kak is not installed' >&2
    exit 1
}

[ -n "${KAK_PICKER_SESSION:-}" ] || {
    printf '%s\n' 'kak-broot-open: KAK_PICKER_SESSION is not set' >&2
    exit 1
}

[ -n "${KAK_PICKER_CLIENT:-}" ] || {
    printf '%s\n' 'kak-broot-open: KAK_PICKER_CLIENT is not set' >&2
    exit 1
}

path=${1:-}
[ -n "$path" ] || exit 0

case "$path" in
    /*)
        ;;
    *)
        path=$PWD/$path
        ;;
esac

[ -f "$path" ] || [ -L "$path" ] || exit 0

path_q=$(printf '%s' "$path" | sed "s/'/''/g")
printf "evaluate-commands -try-client '%s' 'edit -existing ''%s'''\n" \
    "$KAK_PICKER_CLIENT" \
    "$path_q" | kak -p "$KAK_PICKER_SESSION"
