#!/bin/sh

set -eu

open_helper="${HOME}/.local/bin/kak-picker-open"
split_helper="${HOME}/.local/bin/kak-fzf-split-open"

fail() {
    printf '%s\n' "$*" >&2
    exit 1
}

require_env() {
    name=$1
    eval "value=\${$name:-}"
    [ -n "$value" ] || fail "kak-picker-global: ${name} is not set"
}

list_matches() {
    require_env KAK_GLOBAL_FILE
    require_env KAK_GLOBAL_LINE
    require_env KAK_GLOBAL_SYMBOL

    action=${KAK_GLOBAL_ACTION:-smart}
    file=$KAK_GLOBAL_FILE
    line=$KAK_GLOBAL_LINE
    symbol=$KAK_GLOBAL_SYMBOL

    command -v global >/dev/null 2>&1 || fail 'kak-picker-global: global command not found in PATH'

    if [ -d "$file" ]; then
        context_dir=$file
    else
        context_dir=${file%/*}
    fi

    project_root=$(global -C "$context_dir" --print root 2>/dev/null || true)
    [ -n "$project_root" ] || fail "kak-picker-global: no GTAGS database found from $context_dir"

    err=$(mktemp "${TMPDIR:-/tmp}/kak-global-error.XXXXXX") || fail 'kak-picker-global: unable to create a temporary error file'
    case "$action" in
        smart)
            results=$(global -C "$project_root" --from-here "${line}:${file}" --literal --result=grep \
                --path-style=absolute --color=never -N "$file" "$symbol" 2>"$err" || true)
            ;;
        references)
            results=$(global -C "$project_root" -r --literal --result=grep \
                --path-style=absolute --color=never -N "$file" "$symbol" 2>"$err" || true)
            ;;
        callers)
            results=$(global -C "$project_root" -r --literal --result=grep \
                --path-style=absolute --color=never -N "$file" "$symbol" 2>"$err" || true)
            ;;
        symbol)
            results=$(global -C "$project_root" --literal --result=grep \
                --path-style=absolute --color=never "$symbol" 2>"$err" || true)
            if [ -z "$results" ]; then
                : >"$err"
                results=$(global -C "$project_root" -s --literal --result=grep \
                    --path-style=absolute --color=never "$symbol" 2>"$err" || true)
            fi
            ;;
        *)
            rm -f "$err"
            fail "kak-picker-global: unsupported action: $action"
            ;;
    esac
    err_text=$(tr '\n' ' ' <"$err")
    rm -f "$err"

    if [ -n "$err_text" ] && [ -z "$results" ]; then
        fail "$err_text"
    fi

    if [ -z "$results" ]; then
        exit 0
    fi

    printf '%s\n' "$results" | awk 'NF && !seen[$0]++'
}

interactive_picker() {
    results_file=${KAK_GLOBAL_RESULTS_FILE:-}
    action=${KAK_GLOBAL_ACTION:-smart}
    if [ -n "$results_file" ] && [ -f "$results_file" ]; then
        results=$(cat "$results_file")
    else
        results=$(list_matches)
    fi

    [ -n "$results" ] || exit 0

    command -v fzf >/dev/null 2>&1 || fail 'kak-picker-global: fzf command not found in PATH'
    [ -x "$open_helper" ] || fail "kak-picker-global: helper not found: $open_helper"

    case "$action" in
        smart)
            prompt='global def> '
            ;;
        references)
            prompt='global ref> '
            ;;
        callers)
            prompt='global callers> '
            ;;
        symbol)
            prompt='global symbol> '
            ;;
        *)
            prompt='global> '
            ;;
    esac

    if [ -n "${KAK_PICKER_SESSION:-}" ] \
        && [ -n "${KAK_PICKER_ORIGINAL_PANE:-}" ] \
        && [ -x "$split_helper" ]; then
        selection=$(
            printf '%s\n' "$results" | \
                fzf --reverse --prompt "$prompt" \
                    --header 'enter: open  /  ctrl-o: open in split' \
                    --bind "ctrl-o:execute-silent($split_helper '$KAK_PICKER_SESSION' '$KAK_PICKER_ORIGINAL_PANE' {})+abort"
        )
    else
        selection=$(
            printf '%s\n' "$results" | \
                fzf --height=40% --reverse --prompt "$prompt"
        )
    fi

    [ -n "$selection" ] || exit 0

    filepath=$(printf '%s' "$selection" | cut -d: -f1)
    lineno=$(printf '%s' "$selection" | cut -d: -f2)

    [ -n "$filepath" ] || fail 'kak-picker-global: unable to parse selected path'
    [ -n "$lineno" ] || fail 'kak-picker-global: unable to parse selected line number'

    exec "$open_helper" grep "$filepath" "$lineno"
}

case "${1:-}" in
    --list)
        list_matches
        ;;
    '')
        interactive_picker
        ;;
    *)
        fail "kak-picker-global: unknown mode: $1"
        ;;
esac
